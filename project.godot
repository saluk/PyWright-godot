[network]

limits/debugger/max_chars_per_second=404800
limits/debugger/max_queued_messages=10000

[physics]

common/physics_jitter_fix=0.0
common/enable_pause_aware_picking=true

[rendering]

environment/defaults/default_clear_color=Color(0.175227, 0.261064, 0.315127, 1)
environment/defaults/default_environment="res://default_env.tres"
2d/options/use_nvidia_rect_flicker_workaround=true
quality/intended_usage/framebuffer_allocation=0
quality/intended_usage/framebuffer_allocation.mobile=1
threads/thread_model=2
misc/lossless_compression/force_png=true
gles2/compatibility/disable_half_float=true
batching/precision/uv_contract=true
