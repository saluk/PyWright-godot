; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GodotWright"
run/main_scene="res://Main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="GodotWright"
config/features=PackedStringArray("4.4")
config/icon="res://icon.png"

[autoload]

Commands="*res://System/WrightScript/Commands.gd"
ZLayers="*res://System/Scene/ZLayers.gd"
MusicPlayer="*res://System/Audio/MusicPlayer.gd"
SoundPlayer="*res://System/Audio/SoundPlayer.gd"
WSExpression="*res://System/WrightScript/WSExpression.gd"
DirectoryCache="*res://System/Files/DirectoryCache.gd"
ObjectFactory="*res://System/Scene/ObjectFactory.gd"
FilePathCache="*res://System/LeastUsedCache.gd"
AnimationFramesCache="*res://System/LeastUsedCache.gd"
SoundFileCache="*res://System/LeastUsedCache.gd"
ScreenManager="*res://System/Scene/ScreenManager.gd"
Configuration="*res://System/Config/Configuration.gd"
GlobalErrors="*res://System/UI/tools/GlobalErrors.gd"
StandardVar="*res://System/WrightScript/StandardVar.gd"

[debug]

gdscript/warnings/unused_variable=false
gdscript/warnings/shadowed_variable=false
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/integer_division=false
gdscript/warnings/native_method_override=0
shader_language/warnings/treat_warnings_as_errors=true
gdscript/warnings/unused_argument=false

[display]

window/size/viewport_width=1024
window/size/viewport_height=768
window/stretch/mode="viewport"
window/stretch/aspect="keep_width"
window/handheld/orientation="portrait"

[global]

limits=false

[importer_defaults]

texture={
"detect_3d": false,
"flags/anisotropic": true
}
wav={
"edit/loop_mode": 1
}
ogg_vorbis={
"loop": false
}
mp3={
"loop": false
}
font_data_dynamic={
&"antialiasing": 2,
&"compress": false,
&"force_autohinter": true,
&"generate_mipmaps": true,
&"hinting": 2,
&"multichannel_signed_distance_field": true
}

[input]

button_press={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":90,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
